from src.gameState import GameState
from src.parse import parse

def run():
    enter = ""
    state = GameState()
    while enter.lower() != "END":
        enter = input()
        type = parse(enter, state)
        if type == "END":
            return 0

if __name__ == "__main__":
    run()

